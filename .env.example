# Copy to .env and fill in. Never commit .env.

# Core
DATABASE_URL=sqlite:///./assistant.db
CONFIG_PATH=config/config.yaml
RUBRIC_PATH=config/rubric.yaml
CONTACTS_PATH=config/contacts.yaml
APPROVAL_POLICY_PATH=config/approval_policy.yaml
LOG_LEVEL=INFO
# Run the built-in scheduler (briefs, background sync). Set false if cron drives it (docs/SCHEDULING.md).
SCHEDULER_ENABLED=true
# Public URL of the backend; OAuth providers redirect to <this>/oauth/<provider>/callback.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Behind a tunnel (Cloudflare, Tailscale) set true so rate limits see each real client.
# TRUST_PROXY_HEADERS=true
# Tailscale auth key for the fixed phone address: docker compose --profile link up -d (docs/DEPLOY.md).
TS_AUTHKEY=
# Your own email address; the assistant emails you notices here when no chat channel is set up.
CEO_EMAIL=
# Shared secret clients exchange for their own token via POST /auth/token.
API_AUTH_TOKEN=
# Key for encrypting OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Claude API (the only paid service)
ANTHROPIC_API_KEY=

# Google Calendar + Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 (Graph)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Task tools
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_USER_ID=
# Status name that counts as done in your ClickUp space.
CLICKUP_DONE_STATUS=complete

# Notifications (docs/SETUP.md)
# Telegram: create a bot with @BotFather, then send it /start to learn your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CEO_CHAT_ID=
# Long-poll Telegram for button presses and your messages. Turn off if another process does.
TELEGRAM_POLLING=true
# Slack: a bot token (xoxb-...) with chat:write, im:write, im:history, reactions:read.
SLACK_BOT_TOKEN=
# Your own Slack member id, for notices to you.
SLACK_CEO_USER_ID=
# Teams: an incoming-webhook URL of a channel you read, for notices to you.
TEAMS_WEBHOOK_URL=

# Web Push to the phone app (free). Generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Voice (optional; install with pip install -e ".[voice]")
# Folder holding Piper .onnx voices (docs/SETUP.md, "Voices").
PIPER_VOICES_DIR=voices
# Folder of the phone app the backend serves at /. Leave unset for the bundled mobile-pwa/.
# PWA_DIR=
