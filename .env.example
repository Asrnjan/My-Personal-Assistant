# Copy to .env and fill in. Never commit .env.

# Core
DATABASE_URL=sqlite:///./assistant.db
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO
# Shared secret clients exchange for their own token via POST /auth/token.
API_AUTH_TOKEN=
# Key for encrypting OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Claude API (the only paid service)
ANTHROPIC_API_KEY=

# Google Calendar + Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 (Graph)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# Task tools
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
ASANA_ACCESS_TOKEN=
CLICKUP_API_TOKEN=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CEO_CHAT_ID=
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

# Web Push (generate your own, free)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
